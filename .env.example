# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# Never commit `.env`. Only `.env.example` belongs in version control.
# ---------------------------------------------------------------------------

# Database (Prisma).
# The schema provider is inferred from this URL by scripts/prepare-db.mjs, which
# runs from `postinstall` and `vercel-build`:
#   postgresql:// or postgres://  -> provider "postgresql"
#   file:...                      -> provider "sqlite"
# They must agree; a mismatch fails the build on purpose.
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Optional. Neon's pooled URL (host contains "-pooler"). Prefer this on a
# serverless host so many short-lived functions do not exhaust direct connections.
DATABASE_URL_POOLED=""

# Optional override. Normally leave this unset — the provider follows DATABASE_URL.
# DATABASE_PROVIDER="postgresql"

# Working offline? Point DATABASE_URL at a SQLite file instead and the provider
# switches to "sqlite" automatically:
# DATABASE_URL="file:./dev.db"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="7"

# Public site URL (used for links in emails/notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed admin account (created by `pnpm db:seed`)
SEED_ADMIN_EMAIL="admin@evently.test"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional: email delivery for verification/reset links. If unset, codes are
# written to the server log instead (dev-friendly).
EMAIL_FROM="Evently <no-reply@evently.test>"
RESEND_API_KEY=""
