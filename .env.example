# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env`. Only `.env.example` belongs in version control.
# ---------------------------------------------------------------------------

# Database (Prisma). SQLite for local dev; swap for a Postgres URL in prod.
DATABASE_URL="file:./dev.db"

# Leave unset locally (keeps the schema on SQLite). Set to "postgresql" on the
# host — the build then rewrites prisma/schema.prisma and generates a Postgres
# client. See docs/DEPLOYMENT.md.
# DATABASE_PROVIDER="postgresql"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="7"

# Public site URL (used for links in emails/notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed admin account (created by `pnpm db:seed`)
SEED_ADMIN_EMAIL="admin@evently.test"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional: email delivery for verification/reset links. If unset, links are
# logged to the server console instead (dev-friendly).
EMAIL_FROM="Evently <no-reply@evently.test>"
RESEND_API_KEY=""
